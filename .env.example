# Copier en .env.local — JAMAIS versionné.
# Le navigateur n'utilise QUE la clé anon/publishable. La clé service_role
# n'a rien a faire ici, ni dans le depot (regle A2.4).
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Endpoint d'envoi de photos sur o2switch (le PHP vit deja sur le serveur).
VITE_UPLOAD_ENDPOINT=https://akora.fonenako.mg/api/o2upload.php
VITE_DELETE_ENDPOINT=https://akora.fonenako.mg/api/o2delete.php

# Origine publique du site (canoniques, sitemap, partage).
VITE_SITE_URL=https://akora.fonenako.mg
